{
  "expo": {
    "name": "Uklon Clone",
    "slug": "uklon-clone",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.uklonclone",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Геолокація потрібна, щоб визначити, звідки вас забрати."
      }
    },
    "android": {
      "package": "com.example.uklonclone",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "plugins": [
      "expo-location",
      [
        "react-native-maps",
        {
          "iosGoogleMapsApiKey": "AIzaSyAPk81sEbAtq6wnkchFY8Imnwh1NqF0qGU",
          "androidGoogleMapsApiKey": "AIzaSyAPk81sEbAtq6wnkchFY8Imnwh1NqF0qGU"
        }
      ]
    ]
  }
}